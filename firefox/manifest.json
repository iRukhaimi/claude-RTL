{
  "manifest_version": 3,
  "name": "Claude RTL",
  "version": "1.0.1",
  "description": "Per-paragraph RTL/LTR auto-direction for claude.ai. Lightweight, no tracking.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Claude RTL"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-rtl@alkindy.tech",
      "strict_min_version": "115.0"
    }
  }
}
